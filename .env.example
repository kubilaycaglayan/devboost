# ==============================================================================
# Port Tracker Environment Configuration
# Copy this file to .env and configure for your remote server.
# ==============================================================================

# Remote SSH Host alias (from your ~/.ssh/config) or IP address
PORT_TRACKER_SSH_HOST=my-remote-server

# Friendly display name for the server in the UI
PORT_TRACKER_SERVER_NAME="Remote Ubuntu Server"

# Optional IP address shown in dashboard header
PORT_TRACKER_SERVER_IP=192.168.1.100

# Local port for the Web Dashboard server
PORT_TRACKER_DASHBOARD_PORT=3080

# macOS LaunchAgent domain and prefix for persistent forward services
PORT_TRACKER_AGENT_DOMAIN=com.user.port-tracker
PORT_TRACKER_AGENT_PREFIX=com.user.ssh-forward

# Local configuration & log storage directories
PORT_TRACKER_CONFIG_DIR=~/.config/port-tracker
PORT_TRACKER_LOG_DIR=~/Library/Logs
