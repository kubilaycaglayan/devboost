# ==============================================================================
# DevBoost Environment Configuration
# Copy this file to app/.env and configure your initial server:
#   mkdir -p app && cp .env.example app/.env
# (Legacy root .env still works as a fallback.)
# Legacy PORT_TRACKER_* names still work as fallbacks.
#
# MULTI-SERVER NOTES:
# - .env only bootstraps the FIRST server tab (single SSH connection).
# - Additional tabs are added in the dashboard via "+ Add Server", which lists
#   hosts from your ~/.ssh/config for selective import (nothing is auto-added).
# - Tabs are stored in ~/.config/devboost/config.json ("servers" array) with
#   per-tab order/pinned state — no restart or .env change needed afterwards.
# ==============================================================================

# Initial SSH Host alias (from your ~/.ssh/config) or IP address
DEVBOOST_SSH_HOST=my-remote-server

# Friendly display name for the initial server tab in the UI
DEVBOOST_SERVER_NAME="Remote Ubuntu Server"

# Optional IP address shown in dashboard header
DEVBOOST_SERVER_IP=192.168.1.100

# Local port for the Web Dashboard server
DEVBOOST_DASHBOARD_PORT=3080

# macOS LaunchAgent domain and prefix for persistent forward services
# (per-server agents are namespaced as <prefix>-<server-id>-<port>,
# except the first/migrated server which keeps <prefix>-<port> for compat)
DEVBOOST_AGENT_DOMAIN=com.user.devboost
DEVBOOST_AGENT_PREFIX=com.user.devboost-forward

# Local configuration & log storage directories
DEVBOOST_CONFIG_DIR=~/.config/devboost
DEVBOOST_LOG_DIR=~/Library/Logs
