# Local untracked state (per-checkout): app/.env, app/config.json
# Executable stays in ~/.config/devboost (TCC-safe); only state lives here.
/app/

# Environment and credentials (legacy root locations, kept ignored for migration)
.env
*.env.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
htmlcov/

# Logs and runtime artifacts
*.log
*.err
.agents/

# macOS system files
.DS_Store
.AppleDouble
.LSOverride

# Local instance config (use config.example.json as template)
config.json

# iOS local build and Xcode workspace state
ios/DevBoost/.build/
ios/DevBoost/DevBoost.xcodeproj/**/xcuserdata/
ios/DevBoost/DevBoost.xcodeproj/DevBoost.xcodeproj/

# Captured camera-transfer samples used for local diagnosis
IMG_*.HEIC
IMG_*.heic
IMG_*.PNG
IMG_*.png
