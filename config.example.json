{
  "servers": [
    {
      "id": "my-remote-server",
      "ssh_host": "my-remote-server",
      "name": "Remote Ubuntu Server",
      "ip": "192.168.1.100",
      "order": 0,
      "pinned": true
    },
    {
      "id": "prod-server",
      "ssh_host": "prod-server",
      "name": "Production Server",
      "ip": "",
      "order": 1,
      "pinned": false
    }
  ],
  "server_labels": {
    "my-remote-server": {
      "3000": "Web Application",
      "3030": "Grafana Dashboard",
      "8080": "Docker Service",
      "9090": "Prometheus Metrics",
      "11434": "Ollama LLM API",
      "43127": "Extension Hot-Reload"
    },
    "prod-server": {
      "8080": "Prod Web App"
    }
  },
  "labels": {
    "3000": "Web Application",
    "3030": "Grafana Dashboard"
  },
  "history": [
    {
      "server_id": "my-remote-server",
      "local_port": 3030,
      "remote_port": 3030,
      "label": "Grafana Dashboard",
      "last_used": 0
    }
  ],
  "syncs": [
    {
      "id": "a1b2c3d4",
      "server_id": "my-remote-server",
      "local_path": "/Users/you/projects/app",
      "remote_path": "~/projects/app",
      "direction": "two-way",
      "mirror": false,
      "always": true,
      "interval": 15,
      "created_at": 0,
      "last_sync": null,
      "last_status": "never",
      "last_message": ""
    }
  ],
  "folder_history": [
    {
      "server_id": "my-remote-server",
      "local_path": "/Users/you/projects/app",
      "remote_path": "~/projects/app",
      "last_used": 0
    }
  ],
  "usage_accounts": [
    {
      "id": "codex-work",
      "provider": "codex",
      "name": "Work",
      "enabled": true,
      "usage_command": ["your-provider-usage-command", "--json"],
      "local_path": "~/.codex/sessions",
      "api_mode": false,
      "api_days": 1
    },
    {
      "id": "api-personal",
      "provider": "custom",
      "name": "API credits",
      "enabled": true,
      "balance_url": "https://api.example.com/balance",
      "token_env": "MY_API_TOKEN",
      "api_mode": false,
      "api_days": 1
    }
  ],
  "usage_snapshots": {}
}
